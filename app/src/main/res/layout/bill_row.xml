<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="5dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/date_group"
        android:text=""
        android:textSize="14sp"
        android:textColor="#536B60"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/edit_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:background="@drawable/paper_card">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/bill_category"
                android:text=""
                android:textSize="17sp"
                android:textColor="#243A30"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/bill_note"
                android:text=""
                android:textSize="14sp"
                android:textColor="#51675C"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/bill_amount"
            android:text=""
            android:textSize="18sp"
            android:textColor="#274E3C"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
