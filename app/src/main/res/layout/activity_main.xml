<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F1"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/page_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="23sp"
            android:textColor="#193B2D" />
        <TextView
            android:id="@+id/previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="27sp"
            android:textColor="#285B4C"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="上个月"
            android:focusable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/month"
            android:text=""
            android:textSize="15sp"
            android:textColor="#285B4C"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="›"
            android:textSize="27sp"
            android:textColor="#285B4C"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="下个月"
            android:focusable="true" />
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FFFFFF">
        <TextView
            android:id="@+id/nav_ledger"
            style="@style/LedgerTab"
            android:text="明细"
            android:drawableTop="@drawable/ic_details" />
        <TextView
            android:id="@+id/nav_stats"
            style="@style/LedgerTab"
            android:text="统计"
            android:drawableTop="@drawable/ic_stats" />
        <TextView
            android:id="@+id/nav_budget"
            style="@style/LedgerTab"
            android:text="预算"
            android:drawableTop="@drawable/ic_budget" />
    </LinearLayout>
</LinearLayout>
